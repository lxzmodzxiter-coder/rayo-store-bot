# Token HTTP del bot de Telegram. No lo publiques ni lo compartas.
TELEGRAM_BOT_TOKEN=
# ID del canal o grupo de Telegram que recibirá las actualizaciones.
TELEGRAM_TARGET_CHAT_ID=

# Ruta persistente para conservar la sesión vinculada de WhatsApp.
WHATSAPP_AUTH_PATH=./.wwebjs_auth
WHATSAPP_CLIENT_ID=lxz-store-mediafire
WHATSAPP_HEADLESS=false

# Estado para no reenviar la misma publicación dos veces.
STATE_FILE=./data/seen_mediafire.json
MAX_SEEN=5000

# En producción, define la ruta del Chromium instalado por el contenedor.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
